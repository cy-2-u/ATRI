# 复制为 .env，密钥也可稍后在管理页设置。
ADMIN_PASSWORD=
# 留空会在持久数据目录生成 admin-secret.txt。
LLM_FORMAT=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_VISION=false
TAVILY_API_KEY=
TZ=Asia/Shanghai
# 微信联系人 ID 可在管理页出现后允许；填写此项可预先允许指定联系人。
WECHAT_ALLOWED_PEERS=
# 管理页默认只绑定服务器本机，通过 SSH 隧道或 HTTPS 反向代理访问。
ATRI_BIND=127.0.0.1
ATRI_PORT=3000
COOKIE_SECURE=false
# 向量检索默认关闭；也可启动后在管理页“调试与设置”开启并填写模型名。
# 开启后使用 OpenAI 兼容 /embeddings 接口，地址留空时复用 LLM_BASE_URL。
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=
# 向量密钥独立填写，不回退到 LLM_API_KEY；向量服务商与聊天不同渠道时必须单独填写。
EMBEDDING_API_KEY=
# 向量接口地址留空时复用 LLM_BASE_URL；服务商与聊天不同渠道时在此单独填写。
EMBEDDING_BASE_URL=
# 沙箱默认关闭；开启后命令在独立目录中执行，目录和内存均可限额。
SANDBOX_ENABLED=false
SANDBOX_NETWORK=false
SANDBOX_SIZE_MB=512
SANDBOX_MEMORY_MB=2048
