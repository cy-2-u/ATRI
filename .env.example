# 复制为 .env，密钥也可稍后在管理页设置（管理页保存后优先于这里）。
ADMIN_PASSWORD=
# 留空会在持久数据目录生成 admin-secret.txt。
LLM_FORMAT=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_VISION=false
# 备用渠道：主渠道连续 3 轮失败后冷却 1 小时，期间由它接管。
FALLBACK_LLM_FORMAT=openai
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_VISION=false
# 她的眼：Tavily 搜索；向量语义召回（地址留空复用主渠道地址）。
TAVILY_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
TZ=Asia/Shanghai
XING_BIND=127.0.0.1
XING_PORT=3000
COOKIE_SECURE=false
# 她的手：沙箱默认关闭；开启后命令在独立目录执行，容量与内存可限额。
# 沙箱不只是安全边界——也是她的手：心跳里她真实做成的事都发生在这里。
SANDBOX_ENABLED=false
SANDBOX_NETWORK=false
SANDBOX_SIZE_MB=512
SANDBOX_MEMORY_MB=2048
