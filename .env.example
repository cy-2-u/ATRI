# 复制为 .env，密钥也可稍后在管理页设置（管理页保存后优先于这里）。
ADMIN_PASSWORD=
# 留空会在持久数据目录生成 admin-secret.txt。
LLM_FORMAT=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_VISION=false
TAVILY_API_KEY=
TZ=Asia/Shanghai
# 微信联系人 ID 可在管理页出现后允许；填写此项可预先允许指定联系人。
WECHAT_ALLOWED_PEERS=
XING_BIND=127.0.0.1
XING_PORT=3000
COOKIE_SECURE=false
# 向量检索默认关闭；地址留空复用 LLM_BASE_URL，密钥独立不回退。
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 沙箱默认关闭；开启后命令在独立目录中执行，目录与内存均可限额。
# 沙箱不只是安全边界——它也是她的手：心跳里她真的做的事都发生在这里。
SANDBOX_ENABLED=false
SANDBOX_NETWORK=false
SANDBOX_SIZE_MB=512
SANDBOX_MEMORY_MB=2048
